{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server... build && cd artifacts/public-web && npx vite build",
  "outputDirectory": "artifacts/public-web/dist/public",
  "functions": {
    "api/*.js": {
      "includeFiles": "{artifacts/api-server/dist/**,node_modules/@electric-sql/pglite/**,node_modules/pg/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
