# ─────────────────────────────────────────────────────────────
# RAJ TRADERS — VPS Production Environment Variables (.env)
# ─────────────────────────────────────────────────────────────

# Database Credentials (used by Postgres container and Node.js)
POSTGRES_DB=rajtraders
POSTGRES_USER=rajadmin
POSTGRES_PASSWORD=ChangeThisToAStrongDbPassword2026!

# Redis Password (used by Redis container and Node.js)
REDIS_PASSWORD=ChangeThisToAStrongRedisPassword2026!

# Payment Gateway (Live Razorpay Credentials)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret

# Email Gateway (Nodemailer or Hostinger REST API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notifications.rajtraders@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="RAJ TRADERS Notifications <notifications.rajtraders@gmail.com>"

# Optional Cloudflare R2 Credentials (if syncing from VPS to R2 bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# CORS Domains
CORS_ORIGINS=https://sundarvan.xyz,https://admin.sundarvan.xyz
