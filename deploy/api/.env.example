# ─────────────────────────────────────────────────────────────
# RAJ TRADERS — Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────
# Leave empty to use local PGlite (.local-db folder)
# Set to a PostgreSQL connection string for production
DATABASE_URL=

# ─── Razorpay Payment Gateway ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Nodemailer SMTP (Email Verification & Password Recovery) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notifications.rajtraders@gmail.com
SMTP_PASS=NOTIFICATIONS@RAJ
SMTP_FROM=My Shop <notifications.rajtraders@gmail.com>

# ─── Cloudflare R2 Object Storage (Product Images) ──────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Shop Defaults ──────────────────────────────────────────
SHOP_NAME=
SHOP_ADDRESS=
SHOP_LATITUDE=
SHOP_LONGITUDE=
DELIVERY_RADIUS_KM=
DELIVERY_ENABLED=true

# ─── Clerk Auth (Optional — for admin SSO) ──────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ADMIN_CLERK_USER_IDS=

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=
